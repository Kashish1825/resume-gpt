# =============================================================
#  .env.example  —  Environment Variables Template
# =============================================================
#  SETUP STEPS:
#  1. Is file ko copy karo:   cp .env.example .env
#  2. .env file kholo aur apni Groq key daalo
#  3. .env file KABHI GitHub par mat daalo!
#
#  FREE Groq API Key kaise lein (sirf 2 minute):
#  Step 1: https://console.groq.com par jao
#  Step 2: "Sign Up" karo — Google account se bhi ho sakta hai
#  Step 3: Left menu mein "API Keys" par click karo
#  Step 4: "Create API Key" button dabao
#  Step 5: Key copy karo (gsk_ se shuru hogi)
#  Step 6: Neeche paste karo
#
#  FREE LIMITS (bahut zyada hain):
#    - 14,400 requests per day
#    - 30 requests per minute
#    - Ek interview = sirf 4 requests
#    - Matlab: 3,600 FREE interviews per day!
# =============================================================

GROQ_API_KEY=gsk_your_groq_api_key_here
